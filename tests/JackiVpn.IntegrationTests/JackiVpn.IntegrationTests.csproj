<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>JackiVpn.IntegrationTests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707;CA1861;CA5394;CA1515;CA2201;CA1001;CA2000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\JackiVpn.Domain\JackiVpn.Domain.csproj" />
    <ProjectReference Include="..\..\src\JackiVpn.Security\JackiVpn.Security.csproj" />
    <ProjectReference Include="..\..\src\JackiVpn.Subscriptions\JackiVpn.Subscriptions.csproj" />
    <ProjectReference Include="..\..\src\JackiVpn.Routing\JackiVpn.Routing.csproj" />
    <ProjectReference Include="..\..\src\JackiVpn.Cores\JackiVpn.Cores.csproj" />
    <ProjectReference Include="..\..\src\JackiVpn.Networking\JackiVpn.Networking.csproj" />
    <ProjectReference Include="..\..\src\JackiVpn.Ipc\JackiVpn.Ipc.csproj" />
    <ProjectReference Include="..\..\src\JackiVpn.Application\JackiVpn.Application.csproj" />
    <ProjectReference Include="..\..\src\JackiVpn.Infrastructure\JackiVpn.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="..\JackiVpn.UnitTests\Fixtures\**\*" Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RepoRoot)cores\bin\**\*" Link="cores\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RepoRoot)cores\bin\manifest.json')" />
  </ItemGroup>
</Project>
