<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <RootNamespace>JackiVpn.Application</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JackiVpn.Domain\JackiVpn.Domain.csproj" />
    <ProjectReference Include="..\JackiVpn.Security\JackiVpn.Security.csproj" />
    <ProjectReference Include="..\JackiVpn.Subscriptions\JackiVpn.Subscriptions.csproj" />
    <ProjectReference Include="..\JackiVpn.Routing\JackiVpn.Routing.csproj" />
    <ProjectReference Include="..\JackiVpn.Cores\JackiVpn.Cores.csproj" />
    <ProjectReference Include="..\JackiVpn.Networking\JackiVpn.Networking.csproj" />
    <ProjectReference Include="..\JackiVpn.Ipc\JackiVpn.Ipc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <!-- Portable build (Android): Windows backends (system proxy, service IPC, WFP tunnel session) excluded. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Connection\ConnectionBackends.cs;Sessions\TunnelSessionManager.cs" />
  </ItemGroup>
</Project>
