<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <RootNamespace>JackiVpn.Networking</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JackiVpn.Domain\JackiVpn.Domain.csproj" />
    <ProjectReference Include="..\JackiVpn.Security\JackiVpn.Security.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <!-- Portable build (Android): only platform-neutral parts; WinINET/WinHTTP/WFP/adapters are Windows-only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="**\*.cs" />
    <Compile Include="Probes\Probes.cs;Probes\LoopbackProxyCredentials.cs;Probes\PortOwner.cs;Journal\NetworkStateJournal.cs;Recovery\RecoveryCoordinator.cs" />
  </ItemGroup>
</Project>
