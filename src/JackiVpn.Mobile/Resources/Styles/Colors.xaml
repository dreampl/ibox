<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Midnight: calm, sober surfaces; colour only where it carries meaning (state, action). -->
    <Color x:Key="Bg">#070B14</Color>
    <Color x:Key="BgTop">#0C1528</Color>
    <Color x:Key="Surface">#0E1626</Color>
    <Color x:Key="Surface2">#131D31</Color>
    <Color x:Key="Surface3">#1A2640</Color>
    <Color x:Key="Stroke">#1E2A42</Color>
    <Color x:Key="Text">#EEF2FF</Color>
    <Color x:Key="Text2">#93A0BC</Color>
    <Color x:Key="Text3">#5E6A85</Color>
    <Color x:Key="Primary">#5B6CFF</Color>
    <Color x:Key="Primary2">#8B97FF</Color>
    <Color x:Key="Teal">#2DD4BF</Color>
    <Color x:Key="Teal2">#14B8A6</Color>
    <Color x:Key="Gaming">#F43F7A</Color>
    <Color x:Key="Streaming">#38BDF8</Color>
    <Color x:Key="Eco">#86EFAC</Color>
    <Color x:Key="Work">#3B82F6</Color>
    <Color x:Key="Warn">#F5B544</Color>
    <Color x:Key="Danger">#FB5C7C</Color>
    <Color x:Key="PrimarySoft">#265B6CFF</Color>
    <Color x:Key="TealSoft">#262DD4BF</Color>
    <Color x:Key="DangerSoft">#26FB5C7C</Color>

    <!-- Kept for older pages (Apps, Sync device). -->
    <Color x:Key="Window">#070B14</Color>
    <Color x:Key="Sidebar">#070B14</Color>
    <Color x:Key="Card">#0E1626</Color>
    <Color x:Key="Input">#131D31</Color>
    <Color x:Key="Border">#1E2A42</Color>
    <Color x:Key="TextSecondary">#93A0BC</Color>
    <Color x:Key="TextMuted">#5E6A85</Color>
    <Color x:Key="Accent">#5B6CFF</Color>
    <Color x:Key="Accent2">#8B97FF</Color>
    <Color x:Key="Success">#2DD4BF</Color>
    <Color x:Key="Warning">#F5B544</Color>
    <Color x:Key="AccentSoft">#265B6CFF</Color>

    <LinearGradientBrush x:Key="PageGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#0C1528" Offset="0" />
        <GradientStop Color="#070B14" Offset="0.55" />
        <GradientStop Color="#060910" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6D7CFF" Offset="0" />
        <GradientStop Color="#4A5AF0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TealGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E9FFFB" Offset="0" />
        <GradientStop Color="#5EEAD4" Offset="0.45" />
        <GradientStop Color="#14B8A6" Offset="1" />
    </LinearGradientBrush>
    <!-- Connected button per mode: gaming magenta-red, streaming blue, eco light green, work medium blue. -->
    <LinearGradientBrush x:Key="GamingGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE4EE" Offset="0" />
        <GradientStop Color="#FB7199" Offset="0.45" />
        <GradientStop Color="#E11D48" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EcoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0FFF4" Offset="0" />
        <GradientStop Color="#A7F3C0" Offset="0.45" />
        <GradientStop Color="#4ADE80" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WorkGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E3EEFF" Offset="0" />
        <GradientStop Color="#6EA4FA" Offset="0.45" />
        <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StreamingGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0F2FF" Offset="0" />
        <GradientStop Color="#60BDFC" Offset="0.45" />
        <GradientStop Color="#0284C7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientH" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#6D7CFF" Offset="0" />
        <GradientStop Color="#4A5AF0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6D7CFF" Offset="0" />
        <GradientStop Color="#4A5AF0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassFillStrong" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1FFFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="0.5" />
        <GradientStop Color="#1AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassRimAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CC6D7CFF" Offset="0" />
        <GradientStop Color="#CC2DD4BF" Offset="1" />
    </LinearGradientBrush>
    <!-- Content fades into the midnight floor under the navigation bar. -->
    <LinearGradientBrush x:Key="BottomScrim" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#00070B14" Offset="0" />
        <GradientStop Color="#B3070B14" Offset="0.45" />
        <GradientStop Color="#F2070B14" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Horizon" Center="0.5,1" Radius="0.75">
        <GradientStop Color="#00000000" Offset="0.62" />
        <GradientStop Color="#2E5B6CFF" Offset="0.71" />
        <GradientStop Color="#105B6CFF" Offset="0.78" />
        <GradientStop Color="#00000000" Offset="0.9" />
    </RadialGradientBrush>
</ResourceDictionary>
