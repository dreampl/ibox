<?xml version="1.0" encoding="utf-8"?>
<!-- Compact widget (2x1 / 4x1): live dot, status and a round power button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp"
    android:animateLayoutChanges="true">

    <FrameLayout android:layout_width="18dp" android:layout_height="18dp">
        <ImageView android:id="@+id/widget_dot_idle" android:layout_width="8dp" android:layout_height="8dp"
            android:layout_gravity="center" android:src="@drawable/widget_dot_idle" android:contentDescription="@null" />
        <ProgressBar android:id="@+id/widget_dot_live" android:layout_width="18dp" android:layout_height="18dp"
            android:indeterminate="true" android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/widget_pulse" android:visibility="gone" />
        <ProgressBar android:id="@+id/widget_spinner" style="?android:attr/progressBarStyleSmall"
            android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center"
            android:indeterminateTint="#FFF59E0B" android:visibility="gone" />
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="8dp" android:orientation="vertical">
        <TextView android:id="@+id/widget_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="IBOX" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold"
            android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/widget_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Not connected" android:textColor="#FFA6ADBB" android:textSize="11sp"
            android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>

    <ImageView android:id="@+id/widget_toggle" android:layout_width="40dp" android:layout_height="40dp"
        android:background="@drawable/widget_circle_off" android:src="@drawable/ic_power" android:scaleType="center"
        android:contentDescription="Connect or disconnect" />
</LinearLayout>