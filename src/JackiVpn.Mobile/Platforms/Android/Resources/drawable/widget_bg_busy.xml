<?xml version="1.0" encoding="utf-8"?>
<!-- Connecting: black glass with a blue/violet bloom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF0E1016" android:endColor="#FF000000" android:angle="315" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="220dp" android:centerX="0.1" android:centerY="0.1"
                android:startColor="#403B82F6" android:centerColor="#148B5CF6" android:endColor="#00000000" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#443B82F6" />
        </shape>
    </item>
</layer-list>