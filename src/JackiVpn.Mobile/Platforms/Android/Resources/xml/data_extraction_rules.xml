<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing is copied to cloud backup or device-to-device transfer. -->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="root" />
		<exclude domain="file" />
		<exclude domain="database" />
		<exclude domain="sharedpref" />
	</cloud-backup>
	<device-transfer>
		<exclude domain="root" />
		<exclude domain="file" />
		<exclude domain="database" />
		<exclude domain="sharedpref" />
	</device-transfer>
</data-extraction-rules>
