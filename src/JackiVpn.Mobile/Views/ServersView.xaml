<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="JackiVpn.Mobile.Views.ServersView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JackiVpn.Mobile.Controls"
             xmlns:loc="clr-namespace:JackiVpn.Mobile.Localization"
             xmlns:vm="clr-namespace:JackiVpn.Mobile.ViewModels"
             x:DataType="vm:ServersViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="20,8,20,0" RowSpacing="12">
        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" HeightRequest="52">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="{loc:T Servers_Title}" Style="{StaticResource Title}" />
                <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <Border Grid.Column="1" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource Surface2}" Stroke="{StaticResource Stroke}">
                <controls:Icon Name="plus" Size="20" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ImportCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <Border x:Name="TestButton" Grid.Column="2" WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 15" StrokeThickness="0" Background="{StaticResource PrimaryGradient}">
                <Grid>
                    <controls:Icon Name="bolt" Size="20" IsVisible="{Binding IsTesting, Converter={StaticResource Not}}" />
                    <controls:OrbView State="Searching" IsVisible="{Binding IsTesting}" Tint="White" WidthRequest="24" HeightRequest="24" />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTestTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1" Style="{StaticResource GlassInput}" HeightRequest="48">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <controls:Icon Name="search" Size="18" Color="{StaticResource Text3}" />
                <Entry Grid.Column="1" Text="{Binding Filter}" Placeholder="{loc:T Servers_Search}" VerticalOptions="Center" />
            </Grid>
        </Border>

        <controls:SegmentedControl Grid.Row="2" Items="{Binding Segments}" SelectedIndex="{Binding Segment}" />

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,0">
            <controls:Icon Name="sync" Size="20" Color="{StaticResource Text2}" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{loc:T Servers_Auto}" FontFamily="OpenSansSemibold" FontSize="15" />
                <Label Text="{loc:T Servers_AutoHint}" Style="{StaticResource Caption}" FontSize="11" />
            </VerticalStackLayout>
            <controls:ToggleSwitch Grid.Column="2" IsToggled="{Binding AutoSelection}" OnColor="{StaticResource Teal}" />
        </Grid>

        <!-- The list sits on a sheet-like surface with a handle, as in the reference design. -->
        <Border Grid.Row="4" StrokeShape="RoundRectangle 28,28,0,0" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Stroke}" Margin="-8,0" Padding="12,0">
            <Grid RowDefinitions="Auto,*">
                <Border WidthRequest="40" HeightRequest="5" StrokeShape="RoundRectangle 3" StrokeThickness="0" BackgroundColor="#33FFFFFF" HorizontalOptions="Center" Margin="0,10,0,0" />
                <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                    <CollectionView x:Name="List" ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="16,50" Spacing="8">
                                <controls:Icon Name="servers" Size="40" Color="{StaticResource Text3}" />
                                <Label Text="{loc:T Servers_Empty}" Style="{StaticResource Section}" HorizontalOptions="Center" />
                                <Label Text="{loc:T Servers_EmptyHint}" Style="{StaticResource Hint}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.Footer>
                            <BoxView HeightRequest="120" Color="Transparent" />
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>
            </Grid>
        </Border>
    </Grid>
</ContentView>
