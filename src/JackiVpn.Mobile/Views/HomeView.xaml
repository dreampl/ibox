<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="JackiVpn.Mobile.Views.HomeView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:JackiVpn.Mobile.Controls"
             xmlns:loc="clr-namespace:JackiVpn.Mobile.Localization"
             xmlns:vm="clr-namespace:JackiVpn.Mobile.ViewModels"
             x:DataType="vm:HomeViewModel">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="20,8,20,0">
        <!-- Horizon: a planet rim glowing at the top (tinted by the connection). -->
        <Ellipse x:Name="Horizon" Grid.RowSpan="4" WidthRequest="1100" HeightRequest="1100" HorizontalOptions="Center" VerticalOptions="Start"
                 Margin="0,-1010,0,0" InputTransparent="True" Fill="{StaticResource Horizon}" />
        <Ellipse x:Name="HorizonRim" Grid.RowSpan="4" WidthRequest="1100" HeightRequest="1100" HorizontalOptions="Center" VerticalOptions="Start"
                 Margin="0,-1010,0,0" InputTransparent="True" StrokeThickness="1.2" Stroke="#335B6CFF" />

        <!-- Top bar -->
        <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="52">
            <Border WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="Black" VerticalOptions="Center">
                <controls:EyeMarkView State="Awake" Animated="False" WidthRequest="21" HeightRequest="21" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="IBOX" FontFamily="OpenSansSemibold" FontSize="18" VerticalOptions="Center" Margin="12,0" />
            <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="12,2,6,2" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <controls:Icon Name="bolt" Size="16" Color="{StaticResource Warn}" />
                    <Label Text="{loc:T Home_Smart}" FontSize="13" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                    <controls:ToggleSwitch IsToggled="{Binding SmartMode}" Scale="0.78" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Hero -->
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="0">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" HeightRequest="22">
                <controls:Icon x:Name="StatusIcon" Name="check" Size="16" Color="{StaticResource Teal}" IsVisible="{Binding IsConnected}" />
                <Label x:Name="StatusLine" Text="{Binding StatusLine}" FontSize="13" TextColor="{StaticResource Text2}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label x:Name="BigText" Text="{Binding BigText}" FontSize="42" FontFamily="OpenSansSemibold" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
            <Label x:Name="SubText" Text="{Binding SubText}" Style="{StaticResource Caption}" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation" MaxLines="2" Margin="12,0" />
            <Border x:Name="ActivityTag" IsVisible="{Binding HasActivity}" HorizontalOptions="Center" Margin="0,10,0,0" Padding="12,5"
                    StrokeShape="RoundRectangle 14" StrokeThickness="1" BackgroundColor="#14FFFFFF">
                <HorizontalStackLayout Spacing="6">
                    <controls:Icon x:Name="ActivityIcon" Name="{Binding ActivityIcon}" Size="16" />
                    <Label x:Name="ActivityLabel" Text="{Binding ActivityText}" FontSize="12" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <controls:PowerButton x:Name="Power" HorizontalOptions="Center" Margin="0,4,0,0" />
        </VerticalStackLayout>

        <!-- Error -->
        <Border x:Name="ErrorCard" Grid.Row="2" IsVisible="{Binding HasError}" BackgroundColor="{StaticResource DangerSoft}" Stroke="#66FB5C7C"
                StrokeShape="RoundRectangle 18" Padding="14,10" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <controls:Icon Name="info" Size="18" Color="{StaticResource Danger}" />
                <Label Grid.Column="1" Text="{Binding LastError}" FontSize="12.5" LineBreakMode="WordWrap" MaxLines="3" />
            </Grid>
        </Border>

        <!-- Location + live numbers (one glance, no scrolling) -->
        <Border x:Name="InfoCard" Grid.Row="3" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Stroke}" StrokeShape="RoundRectangle 24"
                Padding="16,14" Margin="0,0,0,104">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 21" StrokeThickness="0" BackgroundColor="{StaticResource Surface2}">
                        <Label x:Name="FlagLabel" Text="{Binding LocationFlag}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="{Binding LocationTitle}" Style="{StaticResource Value}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding LocationSubtitle}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2" Style="{StaticResource Pill}" Text="{loc:T Home_Change}" Command="{Binding ChooseServerCommand}" VerticalOptions="Center" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource Divider}" />
                <Grid x:Name="Stats" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStatsTapped" />
                    </Grid.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <controls:Icon Name="down" Size="18" Color="{StaticResource Teal}" VerticalOptions="Start" Margin="0,2,0,0" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding DownSpeed}" FontFamily="OpenSansSemibold" FontSize="14" LineBreakMode="NoWrap" />
                            <Label Text="{loc:T Home_Download}" Style="{StaticResource Caption}" FontSize="11" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <controls:Icon Name="up" Size="18" Color="{StaticResource Primary2}" VerticalOptions="Start" Margin="0,2,0,0" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding UpSpeed}" FontFamily="OpenSansSemibold" FontSize="14" LineBreakMode="NoWrap" />
                            <Label Text="{loc:T Home_Upload}" Style="{StaticResource Caption}" FontSize="11" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <controls:Icon Name="clock" Size="18" Color="{StaticResource Warn}" VerticalOptions="Start" Margin="0,2,0,0" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding LatencyText}" FontFamily="OpenSansSemibold" FontSize="14" LineBreakMode="NoWrap" />
                            <Label Text="{loc:T Home_Ping}" Style="{StaticResource Caption}" FontSize="11" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" controls:Motion.Press="True">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenUsageCommand}" />
                    </Grid.GestureRecognizers>
                    <controls:Icon Name="chart" Size="16" Color="{StaticResource Text2}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding UsageLine}" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                    <controls:Icon Grid.Column="2" Name="chevron" Size="14" Color="{StaticResource Text3}" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
