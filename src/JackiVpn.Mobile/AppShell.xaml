<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="JackiVpn.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:JackiVpn.Mobile.Pages"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False"
       Shell.BackgroundColor="{StaticResource Bg}"
       Shell.ForegroundColor="{StaticResource Text}"
       Shell.TitleColor="{StaticResource Text}">
    <!-- One main page with its own floating navigation; sub pages (apps, sync device) are pushed routes. -->
    <ShellContent ContentTemplate="{DataTemplate pages:MainPage}" Route="main" />
</Shell>