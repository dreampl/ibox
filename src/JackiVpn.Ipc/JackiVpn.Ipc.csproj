<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <RootNamespace>JackiVpn.Ipc</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JackiVpn.Domain\JackiVpn.Domain.csproj" />
    <ProjectReference Include="..\JackiVpn.Security\JackiVpn.Security.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <!-- Portable build (Android): the wire contracts only; pipe server/client security is Windows-specific. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="IpcClient.cs;IpcServer.cs;PeerIdentity.cs" />
  </ItemGroup>
</Project>
