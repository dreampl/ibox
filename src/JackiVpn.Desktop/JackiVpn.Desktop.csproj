<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>JackiVpn.Desktop</RootNamespace>
    <AssemblyName>IBOX</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\jacki.ico</ApplicationIcon>
    <!-- WinForms is only used for the tray icon; keep WPF's implicit usings unambiguous. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO0003: the DPI manifest entry is for WPF (Per-Monitor V2); WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFO1000;WFO0003</NoWarn>
    <!-- 2.0: a quieter runtime — no background GC thread, a memory-conserving heap, no tiered PGO instrumentation. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
    <ProjectReference Include="..\JackiVpn.Application\JackiVpn.Application.csproj" />
    <ProjectReference Include="..\JackiVpn.Infrastructure\JackiVpn.Infrastructure.csproj" />
    <ProjectReference Include="..\JackiVpn.NotchKit\JackiVpn.NotchKit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\jacki.ico" />
    <None Include="$(RepoRoot)cores\bin\**\*" Link="cores\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RepoRoot)cores\bin\manifest.json')" />
    <None Include="$(RepoRoot)assets\rulesets\*.srs" Link="rulesets-seed\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RepoRoot)THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RepoRoot)THIRD_PARTY_NOTICES.txt')" />
  </ItemGroup>
</Project>
