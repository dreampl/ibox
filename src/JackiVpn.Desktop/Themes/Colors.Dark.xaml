<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Dark: deep navy-slate matte background, slightly raised clay cards, blue primary, green "connected".
         One token set shared with the light theme (same keys, see Colors.Light.xaml). -->
    <Color x:Key="C.Window">#FF0D1322</Color>
    <Color x:Key="C.Window2">#FF111A2C</Color>
    <Color x:Key="C.Sidebar">#FF111930</Color>
    <Color x:Key="C.Card">#FF161F33</Color>
    <Color x:Key="C.Card2">#FF131B2D</Color>
    <Color x:Key="C.CardHover">#FF1C2740</Color>
    <Color x:Key="C.Tile">#FF1D2840</Color>
    <Color x:Key="C.Input">#FF19233A</Color>
    <Color x:Key="C.Border">#FF263350</Color>
    <Color x:Key="C.Highlight">#1CFFFFFF</Color>
    <Color x:Key="C.Shadow">#FF02050C</Color>
    <Color x:Key="C.ShadowLight">#0AFFFFFF</Color>
    <Color x:Key="C.Text">#FFF1F5F9</Color>
    <Color x:Key="C.TextSecondary">#FF94A3B8</Color>
    <Color x:Key="C.TextMuted">#FF64748B</Color>
    <Color x:Key="C.Accent">#FF3B82F6</Color>
    <Color x:Key="C.AccentHover">#FF5B97F8</Color>
    <Color x:Key="C.Accent2">#FF7C6CF6</Color>
    <Color x:Key="C.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="C.Success">#FF22C55E</Color>
    <Color x:Key="C.Success2">#FF10B981</Color>
    <Color x:Key="C.Warning">#FFF59E0B</Color>
    <Color x:Key="C.Danger">#FFEF4444</Color>
    <Color x:Key="C.Idle">#FF2A3550</Color>
    <Color x:Key="C.Idle2">#FF1B2438</Color>
    <Color x:Key="C.Chart1">#FF22C55E</Color>
    <Color x:Key="C.Chart2">#FF3B82F6</Color>
    <Color x:Key="C.MapDot">#FF2B3A57</Color>
    <!-- Connected orb: green with soft depth (not neon). -->
    <Color x:Key="C.OrbOn1">#FF34D399</Color>
    <Color x:Key="C.OrbOn2">#FF0E9F6E</Color>
    <Color x:Key="C.OrbOn3">#FF06654A</Color>
    <sys:Double x:Key="ShadowOpacity">0.55</sys:Double>
    <sys:Double x:Key="ShadowLightOpacity">0.6</sys:Double>
    <sys:Boolean x:Key="IsLight">False</sys:Boolean>
</ResourceDictionary>
