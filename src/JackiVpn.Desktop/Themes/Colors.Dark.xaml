<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark: neutral graphite surfaces, blue accent. -->
    <Color x:Key="C.Window">#FF15171C</Color>
    <Color x:Key="C.Sidebar">#FF101216</Color>
    <Color x:Key="C.Card">#FF1C1F26</Color>
    <Color x:Key="C.CardHover">#FF242833</Color>
    <Color x:Key="C.Input">#FF22262F</Color>
    <Color x:Key="C.Border">#FF2C313C</Color>
    <Color x:Key="C.Text">#FFE8EAF0</Color>
    <Color x:Key="C.TextSecondary">#FFA6ADBB</Color>
    <Color x:Key="C.TextMuted">#FF6B7280</Color>
    <Color x:Key="C.Accent">#FF3B82F6</Color>
    <Color x:Key="C.AccentHover">#FF5B97F8</Color>
    <Color x:Key="C.Accent2">#FF8B5CF6</Color>
    <Color x:Key="C.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="C.Success">#FF22C55E</Color>
    <Color x:Key="C.Success2">#FF14B8A6</Color>
    <Color x:Key="C.Warning">#FFF59E0B</Color>
    <Color x:Key="C.Danger">#FFEF4444</Color>
    <Color x:Key="C.Idle">#FF3A404D</Color>
    <Color x:Key="C.Idle2">#FF2A2F3A</Color>
</ResourceDictionary>
