<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Blue: deep navy surfaces, cyan accent. -->
    <Color x:Key="C.Window">#FF0B1426</Color>
    <Color x:Key="C.Sidebar">#FF081020</Color>
    <Color x:Key="C.Card">#FF10203A</Color>
    <Color x:Key="C.CardHover">#FF16294A</Color>
    <Color x:Key="C.Input">#FF142746</Color>
    <Color x:Key="C.Border">#FF1F3558</Color>
    <Color x:Key="C.Text">#FFE6EEFF</Color>
    <Color x:Key="C.TextSecondary">#FF9FB3D9</Color>
    <Color x:Key="C.TextMuted">#FF61789F</Color>
    <Color x:Key="C.Accent">#FF38BDF8</Color>
    <Color x:Key="C.AccentHover">#FF67CDFA</Color>
    <Color x:Key="C.Accent2">#FF6366F1</Color>
    <Color x:Key="C.OnAccent">#FF04121F</Color>
    <Color x:Key="C.Success">#FF34D399</Color>
    <Color x:Key="C.Success2">#FF22D3EE</Color>
    <Color x:Key="C.Warning">#FFFBBF24</Color>
    <Color x:Key="C.Danger">#FFF87171</Color>
    <Color x:Key="C.Idle">#FF22385E</Color>
    <Color x:Key="C.Idle2">#FF172A49</Color>
</ResourceDictionary>
