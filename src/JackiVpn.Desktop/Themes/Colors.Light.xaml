<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Light: very light cool grey background, white clay cards with soft diffuse shadows, pastel mint orb,
         soft blue accents, grey-blue secondary text. Same keys as Colors.Dark.xaml. -->
    <Color x:Key="C.Window">#FFEDF1F7</Color>
    <Color x:Key="C.Window2">#FFF5F7FB</Color>
    <Color x:Key="C.Sidebar">#FFF6F8FC</Color>
    <Color x:Key="C.Card">#FFFFFFFF</Color>
    <Color x:Key="C.Card2">#FFFAFBFE</Color>
    <Color x:Key="C.CardHover">#FFF3F6FB</Color>
    <Color x:Key="C.Tile">#FFEFF3F9</Color>
    <Color x:Key="C.Input">#FFF1F4F9</Color>
    <Color x:Key="C.Border">#FFE2E8F0</Color>
    <Color x:Key="C.Highlight">#FFFFFFFF</Color>
    <Color x:Key="C.Shadow">#FF7C8DB0</Color>
    <Color x:Key="C.ShadowLight">#FFFFFFFF</Color>
    <Color x:Key="C.Text">#FF1E293B</Color>
    <Color x:Key="C.TextSecondary">#FF64748B</Color>
    <Color x:Key="C.TextMuted">#FF94A3B8</Color>
    <Color x:Key="C.Accent">#FF3B82F6</Color>
    <Color x:Key="C.AccentHover">#FF2F74E8</Color>
    <Color x:Key="C.Accent2">#FF3B82F6</Color>
    <Color x:Key="C.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="C.Success">#FF22C55E</Color>
    <Color x:Key="C.Success2">#FF34D399</Color>
    <Color x:Key="C.Warning">#FFF59E0B</Color>
    <Color x:Key="C.Danger">#FFEF4444</Color>
    <Color x:Key="C.Idle">#FFE3E9F2</Color>
    <Color x:Key="C.Idle2">#FFCDD6E3</Color>
    <Color x:Key="C.Chart1">#FF4ADE80</Color>
    <Color x:Key="C.Chart2">#FF60A5FA</Color>
    <Color x:Key="C.MapDot">#FFD4DEEB</Color>
    <!-- Connected orb: pastel mint. -->
    <Color x:Key="C.OrbOn1">#FFD1FAE5</Color>
    <Color x:Key="C.OrbOn2">#FF86EFAC</Color>
    <Color x:Key="C.OrbOn3">#FF34D399</Color>
    <sys:Double x:Key="ShadowOpacity">0.22</sys:Double>
    <sys:Double x:Key="ShadowLightOpacity">0.9</sys:Double>
    <sys:Boolean x:Key="IsLight">True</sys:Boolean>
</ResourceDictionary>
