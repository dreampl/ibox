<UserControl x:Class="JackiVpn.Desktop.Views.ConnectButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:JackiVpn.Desktop.Views" xmlns:k="clr-namespace:JackiVpn.Desktop.Views;assembly=JackiVpn.NotchKit"
             Width="236" Height="236">
    <Button x:Name="Root" Cursor="Hand" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Connect or disconnect">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter />
            </ControlTemplate>
        </Button.Template>
        <Grid Width="236" Height="236" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!-- Soft halo in the state colour (matte clay: a wide, low glow, never neon). A radial gradient, not a blur
                 effect: it breathes while connected, and a live blur re-ran on every frame of that. -->
            <Ellipse x:Name="Halo" Width="300" Height="300" Margin="-32" Opacity="0" />

            <!-- Ripples radiate outward while connecting. -->
            <Ellipse x:Name="Ripple1" Width="200" Height="200" Stroke="{DynamicResource B.Accent}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Ripple2" Width="200" Height="200" Stroke="{DynamicResource B.Accent}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Ripple3" Width="200" Height="200" Stroke="{DynamicResource B.Accent}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
            </Ellipse>

            <!-- Outer clay ring: a raised plate the orb sits in (cached shadows, drawn once). -->
            <v:SoftShadow Width="214" Height="214" CornerRadius="107" Kind="Clay" />
            <Ellipse Width="214" Height="214" Fill="{DynamicResource B.CardFill}" Stroke="{DynamicResource B.Border}" StrokeThickness="1" />

            <!-- Track ring + spinner -->
            <Ellipse Width="200" Height="200" Stroke="{DynamicResource B.Border}" StrokeThickness="2" />
            <Path x:Name="Spinner" Width="200" Height="200" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Opacity="0" RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource B.AccentGradientH}"
                  Data="M 100,1.75 A 98.25,98.25 0 0 1 198.25,100">
                <Path.RenderTransform>
                    <RotateTransform x:Name="Spin" Angle="0" />
                </Path.RenderTransform>
            </Path>
            <Ellipse x:Name="StaticRing" Width="200" Height="200" Stroke="{DynamicResource B.Accent}" StrokeThickness="2" StrokeDashArray="2 3" Opacity="0" />
            <Ellipse x:Name="OnRing" Width="200" Height="200" StrokeThickness="2.5" Opacity="0" />

            <!-- Depth under the orb (cached). -->
            <v:SoftShadow Width="176" Height="176" CornerRadius="88" Kind="Soft" />

            <!-- One disc per state; only opacity animates (cheap cross-fade). Connected takes the mode colour: green
                 orb normally; gaming magenta-red, streaming blue, eco light green, work medium blue. -->
            <Ellipse x:Name="IdleDisc" Width="176" Height="176" Fill="{DynamicResource B.OrbIdle}" Opacity="1" />
            <Ellipse x:Name="BusyDisc" Width="176" Height="176" Fill="{DynamicResource B.AccentGradient}" Opacity="0" />
            <Ellipse x:Name="OnDisc" Width="176" Height="176" Opacity="0" />
            <Ellipse x:Name="OnDiscNext" Width="176" Height="176" Opacity="0" />
            <Ellipse x:Name="FailDisc" Width="176" Height="176" Fill="{DynamicResource B.DangerGradient}" Opacity="0" />
            <!-- Clay sheen: lighter top, a thin inner rim. -->
            <Ellipse Width="176" Height="176" StrokeThickness="1.2" Stroke="#38FFFFFF" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#2EFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.5" />
                        <GradientStop Color="#14000000" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- The IBOX "O": asleep (grey) → seeking (thinking orb inside) → awake (lit, blue pupil looking around). -->
                <k:EyeMarkView x:Name="Eye" Width="60" Height="61" HorizontalAlignment="Center" />
                <TextBlock x:Name="Caption" Text="CONNECT" Foreground="#F2FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
                <Ellipse x:Name="CaptionDot" Width="7" Height="7" Margin="0,8,0,0" Fill="#F2FFFFFF" Opacity="0.85" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
