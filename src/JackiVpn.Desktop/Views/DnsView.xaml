<UserControl x:Class="JackiVpn.Desktop.Views.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:JackiVpn.Desktop.Views">
    <UserControl.Resources>
        <!-- Resolver editor reused for remote / direct / bootstrap. -->
        <DataTemplate x:Key="EndpointEditor">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding DataContext.Transports, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Transport}" MinWidth="0" />
                <TextBox Grid.Column="1" Text="{Binding Server}" Margin="8,0,0,0" ToolTip="Server (IP preferred, e.g. 1.1.1.1)" />
                <TextBox Grid.Column="2" Text="{Binding Port}" Margin="8,0,0,0" ToolTip="Port (optional)" />
                <TextBox Grid.Column="3" Text="{Binding Path}" Margin="8,0,0,0" ToolTip="DoH path (default /dns-query)" />
                <TextBox Grid.Column="4" Text="{Binding TlsServerName}" Margin="8,0,0,0" ToolTip="TLS server name (DoT/DoH)" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,26" v:Motion.StaggerChildren="True">
            <TextBlock Text="How site names are looked up. The default (Smart) keeps every lookup encrypted and inside the VPN — usually nothing to change here."
                       Style="{StaticResource Text.PageSubtitle}" />

            <v:ClaySurface>
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DNS mode" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Text.Hint}" MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" MinWidth="180" VerticalAlignment="Top" />
                    </Grid>
                    <Border Style="{StaticResource Banner.Warning}" Visibility="{Binding IsLeakRisk, Converter={StaticResource Bool2Vis}}">
                        <TextBlock Text="This mode can reveal the sites you visit to your ISP or network (DNS leak)." TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </v:ClaySurface>

            <!-- Which DNS: smart (searched per network), the network's own, or one picked / entered by hand. -->
            <v:ClaySurface>
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Outline}" Content="Apply now" VerticalAlignment="Top"
                                Command="{Binding ApplyNowCommand}" Visibility="{Binding CanApplyNow, Converter={StaticResource Bool2Vis}}"
                                ToolTip="Restarts the connection on the same server with the new DNS" />
                        <StackPanel>
                            <TextBlock Text="Which DNS" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="The resolver IBOX asks outside the tunnel: for VPN server addresses, and for sites that go direct if you turn that on below. Names inside the tunnel always use the encrypted resolver above."
                                       Style="{StaticResource Text.Hint}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="DnsChoice" Content="Smart" IsChecked="{Binding IsSmart, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="DnsChoice" Content="Network's own" IsChecked="{Binding IsSystem, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="DnsChoice" Content="Manual" IsChecked="{Binding IsManual, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding InUseText}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" Margin="0,10,0,0" />

                    <!-- Manual: pick from the list, or enter one -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsManual, Converter={StaticResource Bool2Vis}}">
                        <TextBlock Text="Choose from the list" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding ResolverChoices}" SelectedItem="{Binding Chosen, Mode=TwoWay}" DisplayMemberPath="Label" MinWidth="360" HorizontalAlignment="Left" />
                    </StackPanel>

                    <Border Style="{StaticResource Separator.Line}" />
                    <TextBlock Text="Add your own DNS" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
                    <TextBlock Text="An IP address, plain or encrypted (DoH). It is added to the list and to the DNS search, and used right away."
                               Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name, e.g. Office DNS" />
                        <TextBox Grid.Column="1" Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" ToolTip="IP address, e.g. 178.22.122.100" />
                        <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" IsChecked="{Binding NewIsDoh}" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DoH" Style="{StaticResource Text.Label}" />
                        </CheckBox>
                        <TextBox Grid.Column="3" Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" ToolTip="DoH host name (optional), e.g. dns.google"
                                 IsEnabled="{Binding NewIsDoh}" />
                        <Button Grid.Column="4" Style="{StaticResource Button.Primary}" Content="Add and use" Margin="8,0,0,0" Command="{Binding AddCustomCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding EntryError}" Style="{StaticResource Text.Hint}" Foreground="{DynamicResource B.Danger}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding EntryError, Converter={StaticResource Null2Vis}}" />
                    <ItemsControl ItemsSource="{Binding CustomChoices}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="Remove" Padding="10,3"
                                            Command="{Binding DataContext.RemoveCustomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Separator.Line}" />
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding UseChosenForDirect}">
                        <StackPanel>
                            <TextBlock Text="Also use it for sites that go direct" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Sites your rules send outside the VPN are looked up with this DNS instead of the network's (only when the Direct resolver below is Local)." Style="{StaticResource Text.Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </v:ClaySurface>

            <v:ClaySurface>
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <v:OrbView Width="30" Height="30" State="Searching" Margin="0,0,10,0" Visibility="{Binding IsSearching, Converter={StaticResource Bool2Vis}}" />
                            <Button Style="{StaticResource Button.Primary}" Content="Find the best DNS" Command="{Binding SearchCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="DNS search" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="Tests international and Iranian resolvers (plain and encrypted) from this network: speed, and whether they answer honestly or with the filter's block page. The fastest clean one is used when DNS is set to Smart; your own resolvers are tested too." Style="{StaticResource Text.Hint}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding BestText}" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding SearchStatus, Converter={StaticResource Null2Vis}}" />
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Address}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Speed}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Verdict}" VerticalAlignment="Center" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource B.Danger}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Good}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource B.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="5" Content="Use this" Padding="10,3" Margin="6,0,0,0"
                                            Command="{Binding DataContext.UseForServersCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding Good, Converter={StaticResource Bool2Vis}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </v:ClaySurface>

            <!-- DNS of each network adapter (Windows settings, changed through the IBOX service) -->
            <v:ClaySurface Visibility="{Binding HasAdapters, Converter={StaticResource Bool2Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Outline}" Content="Refresh" VerticalAlignment="Top" Command="{Binding RefreshAdaptersCommand}" />
                        <StackPanel>
                            <TextBlock Text="Network adapters" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="The DNS servers Windows uses on each adapter when IBOX is off (and for other apps outside TUN). Pick a ready-made pair or type your own; Automatic takes them from the router again. IBOX remembers the original setting so you can restore it."
                                       Style="{StaticResource Text.Hint}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding AdaptersStatus}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap"
                               Visibility="{Binding AdaptersStatus, Converter={StaticResource Null2Vis}}" />
                    <ItemsControl ItemsSource="{Binding Adapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Hint}" />
                                        <TextBlock Text="{Binding CurrentText}" Style="{StaticResource Text.Hint}" Margin="0,2,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding DataContext.AdapterPresets, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Preset, Mode=TwoWay}" ToolTip="Fill with a ready-made pair" MinWidth="0" />
                                            <TextBox Grid.Column="1" Text="{Binding Servers, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"
                                                     ToolTip="DNS servers, comma separated (IPv4 or IPv6, up to 4)" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                                <Button Style="{StaticResource Button.Primary}" Content="Set" Padding="14,4"
                                                        Command="{Binding DataContext.SetAdapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Button.Ghost}" Content="Automatic" Padding="10,4" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.AutomaticAdapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource Button.Ghost}" Content="Restore" Padding="10,4" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.RestoreAdapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding CanRestore, Converter={StaticResource Bool2Vis}}" ToolTip="Put back what this adapter had before IBOX changed it" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding Message, Converter={StaticResource Null2Vis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </v:ClaySurface>

            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="Resolvers" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="Remote (through the VPN)" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                    <ContentControl Content="{Binding Remote}" ContentTemplate="{StaticResource EndpointEditor}" Focusable="False" />
                    <TextBlock Text="Direct (for traffic routed outside the VPN)" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                    <ContentControl Content="{Binding Direct}" ContentTemplate="{StaticResource EndpointEditor}" Focusable="False" />
                    <TextBlock Text="Bootstrap (only resolves VPN server names)" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                    <ContentControl Content="{Binding Bootstrap}" ContentTemplate="{StaticResource EndpointEditor}" Focusable="False" />
                    <TextBlock Text="Transport Local = the resolvers configured in Windows. Columns: transport, server, port, DoH path, TLS name." Style="{StaticResource Text.Hint}" Margin="0,10,0,0" />
                </StackPanel>
            </v:ClaySurface>

            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="Options" Style="{StaticResource Text.Section}" />
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Cache}" Margin="0,0,0,12">
                        <TextBlock Text="Cache DNS answers in the core" Style="{StaticResource Text.Label}" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding FakeIp}">
                        <StackPanel>
                            <TextBlock Text="Fake IP (TUN)" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Answers tunneled names instantly with placeholder addresses; the server resolves the real address. Faster first connections; a few apps dislike it." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FakeIpV4}" ToolTip="Fake IP IPv4 range" />
                        <TextBox Grid.Column="2" Text="{Binding FakeIpV6}" ToolTip="Fake IP IPv6 range" />
                    </Grid>
                </StackPanel>
            </v:ClaySurface>
        </StackPanel>
    </ScrollViewer>
</UserControl>
