<UserControl x:Class="JackiVpn.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:JackiVpn.Desktop.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,26" v:Motion.StaggerChildren="True">
            <TextBlock Text="Look (light / dark), start-up, the notch, notifications and AI agents." Style="{StaticResource Text.PageSubtitle}" />

            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource Text.Section}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" Style="{StaticResource Text.Label}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                    </Grid>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ReduceMotion}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Reduce motion" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Turns off animations. Also follows the Windows 'Animation effects' setting automatically." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CloseToTray}">
                        <StackPanel>
                            <TextBlock Text="Keep running in the tray when the window is closed" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="The connection stays up; use Exit in the tray menu to quit." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </v:ClaySurface>

            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="Notch" Style="{StaticResource Text.Section}" />
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotchEnabled}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Show the notch at the top of the screen" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="A small black island with the IBOX eye, the connection and the live ping. Hover for more, drag it left or right; it fades after a while — rest the pointer on it for 1.5 s to bring it back. Also in the tray menu." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <StackPanel IsEnabled="{Binding NotchEnabled}">
                        <TextBlock Text="Show in the small notch" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotchShowStatus}" Margin="0,0,24,8"><TextBlock Text="Connection state" Style="{StaticResource Text.Label}" /></CheckBox>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotchShowPing}" Margin="0,0,24,8"><TextBlock Text="Live ping" Style="{StaticResource Text.Label}" /></CheckBox>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotchShowTunnel}" Margin="0,0,24,8"><TextBlock Text="Tunnel (TUN / proxy)" Style="{StaticResource Text.Label}" /></CheckBox>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotchShowServer}" Margin="0,0,24,8"><TextBlock Text="Server" Style="{StaticResource Text.Label}" /></CheckBox>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotchShowCountry}" Margin="0,0,24,8"><TextBlock Text="Country" Style="{StaticResource Text.Label}" /></CheckBox>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotchShowDuration}" Margin="0,0,24,8"><TextBlock Text="Time connected" Style="{StaticResource Text.Label}" /></CheckBox>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotchShowNowPlaying}" Margin="0,0,24,8"><TextBlock Text="Now playing" Style="{StaticResource Text.Label}" /></CheckBox>
                        </WrapPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Fade after (seconds)" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="0 = never fade." Style="{StaticResource Text.Hint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding NotchFadeChoices}" SelectedItem="{Binding NotchFadeAfterSeconds}" />
                        </Grid>
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotchSound}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Soft sound when connected" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="A quiet two-note chime (turning this on plays it once)." Style="{StaticResource Text.Hint}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotchHideInFullScreen}">
                            <StackPanel>
                                <TextBlock Text="Hide while a full-screen app is in front" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="Games, videos and presentations are never covered." Style="{StaticResource Text.Hint}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </v:ClaySurface>

            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="Startup" Style="{StaticResource Text.Section}" />
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12">
                        <TextBlock Text="Start with Windows" Style="{StaticResource Text.Label}" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartMinimized}" Margin="0,0,0,12">
                        <TextBlock Text="Start minimized to the tray" Style="{StaticResource Text.Label}" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AutoConnect}">
                        <StackPanel>
                            <TextBlock Text="Connect automatically on start" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Uses smart selection or your default server, as configured." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </v:ClaySurface>

            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="Notifications" Style="{StaticResource Text.Section}" />
                    <ItemsControl ItemsSource="{Binding Notifications}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" Margin="0,0,24,10">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,6,0,0">
                        <TextBox DockPanel.Dock="Right" Width="90" Text="{Binding TrafficWarningPercent}" />
                        <TextBlock Text="Warn when subscription traffic reaches (%)" Style="{StaticResource Text.Label}" />
                    </DockPanel>
                </StackPanel>
            </v:ClaySurface>

            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="Logging &amp; privacy" Style="{StaticResource Text.Section}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Log level" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Debug adds core output (still redacted). Use only while troubleshooting." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" VerticalAlignment="Top" />
                    </Grid>
                    <DockPanel Margin="0,0,0,12">
                        <TextBox DockPanel.Dock="Right" Width="90" Text="{Binding RetainDays}" />
                        <TextBlock Text="Keep log files for (days)" Style="{StaticResource Text.Label}" />
                    </DockPanel>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Telemetry, Mode=OneWay}" IsEnabled="False">
                        <StackPanel>
                            <TextBlock Text="Telemetry" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Off. IBOX does not collect or send usage data." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Text.Hint}" Margin="0,12,0,0">
                        <Run Text="Data folder: " /><Run Text="{Binding DataFolder, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                    </TextBlock>
                </StackPanel>
            </v:ClaySurface>

            <!-- AI agents: the local control channel and its MCP server (ibox-ctl). -->
            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="AI agents (MCP) &amp; command line" Style="{StaticResource Text.Section}" />
                    <TextBlock Text="Lets an AI assistant (Claude, any MCP client) or scripts on this computer see IBOX's status, servers and rules through ibox-ctl. Only programs running as you can reach it; nothing is opened to the network."
                               Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AgentEnabled}" Margin="0,0,0,10">
                        <TextBlock Text="Allow agent control" Style="{StaticResource Text.Label}" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AgentAllowChanges}" IsEnabled="{Binding AgentEnabled}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Allow changes" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Connect, disconnect, switch server and mode, add or remove rules, change DNS. Off = read only." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="Add to your MCP client's configuration:" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copy" VerticalAlignment="Top" Margin="8,0,0,0" Command="{Binding CopyAgentConfigCommand}" />
                        <TextBox Text="{Binding AgentConfig, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource TextBox.Mono}" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </v:ClaySurface>
        </StackPanel>
    </ScrollViewer>
</UserControl>
