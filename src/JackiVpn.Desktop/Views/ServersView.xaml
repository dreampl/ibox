<UserControl x:Class="JackiVpn.Desktop.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JackiVpn.Desktop.ViewModels"
             xmlns:v="clr-namespace:JackiVpn.Desktop.Views"
             x:Name="Page">
    <DockPanel Margin="32,26,32,16">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Paste / Import…" Command="{Binding ImportPasteCommand}" Margin="0,0,8,0" ToolTip="Paste share links, Base64 lists or full configs" />
                    <Button Content="From clipboard" Command="{Binding ImportClipboardCommand}" Margin="0,0,8,0" />
                    <Button Content="From file…" Command="{Binding ImportFileCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <v:OrbView State="Searching" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center" IsRunning="{Binding IsTesting}" Visibility="{Binding IsTesting, Converter={StaticResource Bool2Vis}}" />
                    <TextBlock Text="{Binding TestProgress}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Cancel" Command="{Binding CancelTestCommand}" Margin="0,0,8,0" Visibility="{Binding IsTesting, Converter={StaticResource Bool2Vis}}" />
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding TestAllCommand}" IsEnabled="{Binding IsTesting, Converter={StaticResource InvBool}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Test visible" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="260">
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="30,6,8,6" AutomationProperties.Name="Search servers" Tag="Search servers" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" HorizontalAlignment="Left" Margin="10,0,0,0"
                                   Foreground="{DynamicResource B.TextMuted}" IsHitTestVisible="False" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding GroupFilter}" Margin="10,0,0,0" MinWidth="170" ToolTip="Subscription" />
                    <ComboBox ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}" Margin="10,0,0,0" MinWidth="120" ToolTip="Sort" />
                </StackPanel>
            </DockPanel>

            <!-- Dual VPN: a second VPN to a company or another server, next to IBOX. -->
            <v:ClaySurface CornerRadius="16" Elevation="Flat" Padding="16,12" Margin="0,0,0,12">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8CE;" FontSize="16" Foreground="{DynamicResource B.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Connect" Command="{Binding ConnectDualVpnCommand}" Margin="0,0,10,0"
                                Visibility="{Binding DualVpnCanDial, Converter={StaticResource Bool2Vis}}" />
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding DualVpnEnabled}" Margin="0,0,14,0" VerticalAlignment="Center"
                                  Visibility="{Binding DualVpnConfigured, Converter={StaticResource Bool2Vis}}" AutomationProperties.Name="Dual VPN on or off" />
                        <Button Command="{Binding EditDualVpnCommand}" AutomationProperties.Name="Set up Dual VPN">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0"
                                           Visibility="{Binding DualVpnConfigured, Converter={StaticResource InvBool2Vis}}" />
                                <TextBlock Text="Add Dual VPN" Visibility="{Binding DualVpnConfigured, Converter={StaticResource InvBool2Vis}}" />
                                <TextBlock Text="Edit" Visibility="{Binding DualVpnConfigured, Converter={StaticResource Bool2Vis}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DualVpnTitle}" FontWeight="SemiBold" FontSize="14" />
                            <Ellipse Width="8" Height="8" Margin="8,1,0,0" Fill="{DynamicResource B.Success}" VerticalAlignment="Center"
                                     Visibility="{Binding DualVpnActive, Converter={StaticResource Bool2Vis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DualVpnStatus}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </v:ClaySurface>
        </StackPanel>

        <Grid>
            <ListBox x:Name="List" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" Style="{StaticResource List.Plain}"
                     ItemContainerStyle="{StaticResource ListItem.Card}" Tag="{Binding}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     AutomationProperties.Name="Servers">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True" Margin="0,6,0,2">
                                                <Expander.Template>
                                                    <ControlTemplate TargetType="Expander">
                                                        <StackPanel>
                                                            <ToggleButton x:Name="Header" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Padding="6,8">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                            <DockPanel>
                                                                                <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource B.TextMuted}" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                                                    <TextBlock.RenderTransform><RotateTransform Angle="0" /></TextBlock.RenderTransform>
                                                                                </TextBlock>
                                                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" VerticalAlignment="Center">
                                                                                    <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" servers" />
                                                                                </TextBlock>
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource B.TextSecondary}" VerticalAlignment="Center" />
                                                                            </DockPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="False">
                                                                                <Trigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="-90" Duration="0:0:0.25">
                                                                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </Trigger.EnterActions>
                                                                                <Trigger.ExitActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25">
                                                                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </Trigger.ExitActions>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="True">
                                                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Expander.Template>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ServerItem}">
                        <Grid Background="Transparent" ToolTip="{Binding Tooltip}"
                              Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Grid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Tag.ConnectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                            </Grid.InputBindings>
                            <Grid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Connect" Command="{Binding ConnectCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Set as default" Command="{Binding SelectDefaultCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Test" Command="{Binding TestOneCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Favorite" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Rename…" Command="{Binding RenameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Edit…" Command="{Binding EditCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Delete" Command="{Binding DeleteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="Star" Style="{StaticResource Button.Icon}" Content="&#xE734;" ToolTip="Favorite"
                                    Command="{Binding Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />

                            <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                            <!-- Round flag: the exit seen through this server, else the country its name points at. -->
                            <v:FlagView DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,14,0" CountryCode="{Binding FlagCode}" ToolTip="{Binding FlagTip}" />
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                    <Border Background="{DynamicResource B.AccentGradient}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsOfficial, Converter={StaticResource Bool2Vis}}" ToolTip="Official Jacki server (verified official subscription)">
                                        <TextBlock Text="✓ Official" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <Border Background="{DynamicResource B.SuccessSoft}" CornerRadius="8" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsFast, Converter={StaticResource Bool2Vis}}" ToolTip="Measured fast in the last test">
                                        <TextBlock Text="⚡ Fast" FontSize="11" Foreground="{DynamicResource B.Success}" />
                                    </Border>
                                    <Border x:Name="ActiveBadge" Background="{DynamicResource B.SuccessSoft}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Active" FontSize="11" Foreground="{DynamicResource B.Success}" />
                                    </Border>
                                    <Border x:Name="DefaultBadge" Background="{DynamicResource B.AccentSoft}" CornerRadius="8" Padding="7,1" Margin="6,0,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Default" FontSize="11" Foreground="{DynamicResource B.Accent}" />
                                    </Border>
                                    <Border x:Name="NewBadge" Background="{DynamicResource B.AccentSoft}" CornerRadius="8" Padding="7,1" Margin="6,0,0,0" Visibility="Collapsed">
                                        <TextBlock Text="New" FontSize="11" Foreground="{DynamicResource B.Accent}" />
                                    </Border>
                                    <Border x:Name="RemovedBadge" Background="{DynamicResource B.DangerSoft}" CornerRadius="8" Padding="7,1" Margin="6,0,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Removed by provider" FontSize="11" Foreground="{DynamicResource B.Danger}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0">
                                    <Run Text="{Binding SubscriptionName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Details, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            </DockPanel>

                            <Border x:Name="LatencyPill" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="11" Padding="9,3"
                                    Background="{DynamicResource B.HoverOverlay}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Label, Converter={StaticResource HealthBrush}}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LatencyText" Text="{Binding Latency}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding ScoreText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <v:OrbView x:Name="Testing" State="Searching" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Testing…" />
                                <Button Style="{StaticResource Button.Primary}" Content="Connect" Command="{Binding Tag.ConnectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="14,6" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="Star" Property="Content" Value="&#xE735;" />
                                <Setter TargetName="Star" Property="Foreground" Value="{DynamicResource B.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="ActiveBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter TargetName="DefaultBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter TargetName="NewBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                <Setter TargetName="RemovedBadge" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                <Setter TargetName="Testing" Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Pulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LatencyPill" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.6"
                                                             AutoReverse="True" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Pulse" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Label}" Value="Excellent">
                                <Setter TargetName="LatencyPill" Property="Background" Value="{DynamicResource B.SuccessSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Label}" Value="Good">
                                <Setter TargetName="LatencyPill" Property="Background" Value="{DynamicResource B.SuccessSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Label}" Value="Average">
                                <Setter TargetName="LatencyPill" Property="Background" Value="{DynamicResource B.WarningSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Label}" Value="Poor">
                                <Setter TargetName="LatencyPill" Property="Background" Value="{DynamicResource B.DangerSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Label}" Value="Failed">
                                <Setter TargetName="LatencyPill" Property="Background" Value="{DynamicResource B.DangerSoft}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" FontSize="40" Foreground="{DynamicResource B.TextMuted}" />
                <TextBlock Text="No servers yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Add a subscription, or paste a config (vless://, vmess://, trojan://, ss://, hysteria2://, tuic://, a sing-box / Xray / Clash file)."
                           Style="{StaticResource Text.Hint}" TextAlignment="Center" MaxWidth="420" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
