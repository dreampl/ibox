<UserControl x:Class="JackiVpn.Desktop.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:JackiVpn.Desktop.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,26" v:Motion.StaggerChildren="True">
            <TextBlock Text="How IBOX connects (the whole system with TUN, or only apps that use the proxy), leak protection and repair tools. Every change to Windows is undone when you disconnect."
                       Style="{StaticResource Text.PageSubtitle}" />

            <!-- Service -->
            <v:ClaySurface>
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <v:OrbView State="Working" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center" IsRunning="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource Bool2Vis}}" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button.Primary}" Content="Install / Repair service" Command="{Binding InstallServiceCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button.Danger}" Content="Remove" Command="{Binding UninstallServiceCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="IBOX service" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="{Binding ServiceStatus}" Style="{StaticResource Text.Hint}" MaxWidth="480" HorizontalAlignment="Left" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="Installing asks for administrator permission once. The app itself never runs as administrator." Style="{StaticResource Text.Hint}" Margin="0,8,0,0" />
                </StackPanel>
            </v:ClaySurface>

            <!-- Mode -->
            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="Connection mode" Style="{StaticResource Text.Section}" />
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="NetMode" Content="TUN (all apps)" IsChecked="{Binding IsTun, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="NetMode" Content="System proxy" IsChecked="{Binding IsProxy, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Text.Hint}" Margin="0,8,0,0"
                               Text="TUN captures all traffic through a virtual adapter (needs the service) and supports the kill switch and DNS leak protection. System proxy only covers apps that honor Windows proxy settings." />
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding SystemProxyInTun}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Also set the system proxy in TUN mode" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Some apps (Claude, some launchers) check the Windows proxy setting and behave differently without one. Their traffic goes through the tunnel either way." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Separator.Line}" />
                    <TextBlock Text="Getting through blocks" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding SecureDnsRescue}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Encrypted DNS for server names" />
                            <TextBlock Text="When the network's DNS lies about or blocks a server's name, its real address is looked up with DNS-over-HTTPS." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CleanIpScan}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Find clean CDN addresses" />
                            <TextBlock Text="For WebSocket/gRPC configs behind Cloudflare whose usual address is filtered: other Cloudflare edges are scanned and tested with real data." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding FingerprintRotation}">
                        <StackPanel>
                            <TextBlock Text="Rotate TLS fingerprints (REALITY / TLS)" />
                            <TextBlock Text="When a handshake is blocked, other browser fingerprints are tried; the one that works is remembered for this network." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Separator.Line}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="IPv6" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Auto enables IPv6 only when the server is proven to carry it; otherwise IPv6 is blocked inside the tunnel so it cannot leak. Windows settings are never changed." Style="{StaticResource Text.Hint}" MaxWidth="520" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Ipv6Modes}" SelectedItem="{Binding Ipv6}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TUN MTU" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="1280–9000. Lower it if some sites stall." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Mtu}" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Reconnect attempts" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Retries with backoff before giving up (smart mode switches server after the first)." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding MaxReconnect}" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </v:ClaySurface>

            <!-- Kill switch -->
            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="Kill switch" Style="{StaticResource Text.Section}" />
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding KillSwitch}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Block internet if the VPN drops" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="TUN: Windows Filtering Platform rules allow only the tunnel (removed automatically on disconnect, crash recovery or reboot). System proxy: proxy-aware apps stay blocked instead of falling back to direct." Style="{StaticResource Text.Hint}" MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AllowLan}" IsEnabled="{Binding KillSwitch}">
                        <StackPanel>
                            <TextBlock Text="Allow local network while blocked" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Printers, NAS, router and casting keep working." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </v:ClaySurface>

            <!-- System proxy -->
            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="System proxy mode" Style="{StaticResource Text.Section}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Local port" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Default 10808 (HTTP + SOCKS). Keep it fixed: some apps (e.g. Claude) remember the proxy address from when they started." Style="{StaticResource Text.Hint}"
                                       MaxWidth="520" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding LocalPort}" VerticalAlignment="Top" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,-4,0,12">
                        <Button Content="Who is using this port?" Command="{Binding CheckPortCommand}" Padding="12,5" />
                    </StackPanel>
                    <TextBlock Text="{Binding PortStatus}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding PortStatus, Converter={StaticResource Null2Vis}}" />
                    <TextBlock Text="Bypass list" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding BypassList}" Style="{StaticResource TextBox.Mono}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding WinHttp}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Also set the machine-wide WinHTTP proxy" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="For services and tools that use WinHTTP. Needs the service; restored on disconnect." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </v:ClaySurface>

            <!-- Repair -->
            <v:ClaySurface>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Repair network" Command="{Binding RepairNetworkCommand}" VerticalAlignment="Top"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                        <StackPanel>
                            <TextBlock Text="Repair network" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="Undoes anything IBOX changed (proxy, kill-switch filters, TUN adapter, WinHTTP) and flushes the DNS cache. Settings from other software are left alone." Style="{StaticResource Text.Hint}" MaxWidth="520" HorizontalAlignment="Left" />
                        </StackPanel>
                    </DockPanel>
                    <TextBox Text="{Binding RepairOutput, Mode=OneWay}" Style="{StaticResource TextBox.Mono}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,12,0,0"
                             Visibility="{Binding RepairOutput, Converter={StaticResource Null2Vis}}" />
                </StackPanel>
            </v:ClaySurface>
        </StackPanel>
    </ScrollViewer>
</UserControl>
