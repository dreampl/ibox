<UserControl x:Class="JackiVpn.Desktop.Views.RoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:JackiVpn.Desktop.Views" xmlns:k="clr-namespace:JackiVpn.Desktop.Views;assembly=JackiVpn.NotchKit"
             xmlns:vm="clr-namespace:JackiVpn.Desktop.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,26" k:Motion.StaggerChildren="True">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource Button.Outline}" Content="Node editor…" Command="{Binding OpenNodeEditorCommand}" Margin="0,0,8,0"
                            ToolTip="Edit the rules as connected nodes in your browser" />
                    <Button Content="Import…" Command="{Binding ImportCommand}" Margin="0,0,8,0" />
                    <Button Content="Export…" Command="{Binding ExportCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Decide which sites and apps go through the VPN, go direct or are blocked. Rules are checked from the top; the first match wins."
                               Style="{StaticResource Text.PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <!-- Presets & defaults -->
            <v:ClaySurface>
                <StackPanel>
                    <TextBlock Text="Preset" Style="{StaticResource Text.Section}" />
                    <ItemsControl ItemsSource="{Binding Presets}" Tag="{Binding}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="0,0,8,8" MinWidth="100"
                                        Command="{Binding Tag.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.Hint}">
                        <Run Text="Current: " /><Run Text="{Binding Preset, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Rule = everything through VPN except BitTorrent; Global = everything through VPN; Direct = nothing through VPN; IranFriendly = Iranian sites and IPs direct, the rest through VPN (every preset rule is editable)." />
                    </TextBlock>

                    <Border Style="{StaticResource Separator.Line}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Unmatched traffic" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="What happens to traffic that matches no rule." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FinalActions}" SelectedItem="{Binding Final}" />
                    </Grid>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding BypassLan}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Keep local network direct" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Printers, NAS and router pages stay reachable (private IP ranges bypass the VPN)." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Sniff}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Detect domains from traffic (sniffing)" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Lets domain rules work even when apps connect by IP." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </v:ClaySurface>

            <!-- Rules -->
            <v:ClaySurface>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Add rule" Command="{Binding AddRuleCommand}" />
                        <TextBlock Text="Rules" Style="{StaticResource Text.Section}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rules}" Tag="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RuleItem}">
                                <Border Background="{DynamicResource B.Input}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Enabled" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PresetText}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource B.AccentSoft}" CornerRadius="8" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActionText}" FontSize="11" Foreground="{DynamicResource B.Accent}" />
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE70E;" ToolTip="Move up"
                                                    Command="{Binding Tag.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE70D;" ToolTip="Move down"
                                                    Command="{Binding Tag.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE70F;" ToolTip="Edit"
                                                    Command="{Binding Tag.EditRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" ToolTip="Delete"
                                                    Command="{Binding Tag.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No rules: everything follows the unmatched-traffic action." Style="{StaticResource Text.Hint}"
                               Visibility="{Binding Rules.Count, Converter={StaticResource ZeroToVis}}" />
                </StackPanel>
            </v:ClaySurface>

            <!-- Rule-sets -->
            <v:ClaySurface>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Add rule-set…" Command="{Binding AddRuleSetCommand}" Margin="0,0,8,0" />
                            <k:OrbView State="Composing" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" IsRunning="{Binding IsUpdatingRuleSets}" Visibility="{Binding IsUpdatingRuleSets, Converter={StaticResource Bool2Vis}}" />
                        <Button Content="Update now" Command="{Binding UpdateRuleSetsCommand}" IsEnabled="{Binding IsUpdatingRuleSets, Converter={StaticResource InvBool}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Rule-sets" Style="{StaticResource Text.Section}" Margin="0" />
                            <TextBlock Text="Downloaded, verified and cached locally; the last good copy is used if an update fails." Style="{StaticResource Text.Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding RuleSets}" Tag="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RuleSetItem}">
                                <Border Background="{DynamicResource B.Input}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE74D;" ToolTip="Remove"
                                                Command="{Binding Tag.RemoveRuleSetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock><Run Text="{Binding Tag, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource B.TextMuted}" FontSize="11" /></TextBlock>
                                            <TextBlock Text="{Binding Url}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Hint}" Visibility="{Binding Message, Converter={StaticResource Null2Vis}}" />
                </StackPanel>
            </v:ClaySurface>
        </StackPanel>
    </ScrollViewer>
</UserControl>
