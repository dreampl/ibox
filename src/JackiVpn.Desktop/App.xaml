<Application x:Class="JackiVpn.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:JackiVpn.Desktop.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The active color theme is inserted at index 0 by ThemeManager. -->
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Bool2Vis" />
            <v:NullToVisibilityConverter x:Key="Null2Vis" />
            <v:ZeroToVisibilityConverter x:Key="ZeroToVis" />
            <v:InverseBoolConverter x:Key="InvBool" />
            <v:InverseBoolToVisibilityConverter x:Key="InvBool2Vis" />
            <v:HealthBrushConverter x:Key="HealthBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
