{
  "manifest_version": 3,
  "name": "IBAR Downloads",
  "version": "2.1.0",
  "description": "Shows this browser's downloads on the IBAR notch (file name, size, speed — never addresses or history).",
  "browser_specific_settings": { "gecko": { "id": "ibar-downloads@jacki.app", "strict_min_version": "115.0" } },
  "permissions": ["downloads", "nativeMessaging"],
  "background": { "scripts": ["background.js"] },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
