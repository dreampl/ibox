{
  "manifest_version": 3,
  "name": "IBAR Downloads",
  "short_name": "IBAR",
  "version": "2.1.0",
  "description": "Shows this browser's downloads on the IBAR notch (file name, size, speed — never addresses or history).",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["downloads", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
